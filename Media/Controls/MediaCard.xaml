<UserControl x:Class="JsonFormatter.Media.Controls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
            CornerRadius="12" Padding="16"
            MaxWidth="600">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶栏：信息 + 关闭 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Accent}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="KindBadge" Text="IMG" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                </Border>
                    <StackPanel>
                        <TextBlock x:Name="FileNameText" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource InkCaption}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                        <TextBlock x:Name="MetaText" FontSize="11.5"
                                   Foreground="{DynamicResource InkHint}"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Content="✕" FontSize="12"
                        Width="26" Height="26" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource InkCaption}"
                        Click="OnClose"/>
            </Grid>

            <!-- 内容区：图片 / PDF 首页 / 视频播放器 -->
            <Border Grid.Row="1" Background="{DynamicResource LineSoft}"
                    CornerRadius="8" Padding="8" Margin="0,0,0,10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Image x:Name="PreviewImage" MaxWidth="560" MaxHeight="420"
                           Stretch="Uniform" StretchDirection="Both"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="StateText" Text="加载中…" FontStyle="Italic"
                               Foreground="{DynamicResource InkHint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <MediaElement x:Name="Player" Visibility="Collapsed"
                                  Width="560" Height="315"
                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  ScrubbingEnabled="True"
                                  MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed"/>
                </Grid>
            </Border>

            <!-- 视频控制条 -->
            <Grid x:Name="VideoBar" Grid.Row="2"
                  Margin="0,0,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Content="▶" FontSize="13" Width="32" Height="26"
                        Cursor="Hand" Click="OnPlayPause"
                        Background="{DynamicResource BtnBg}" BorderBrush="{DynamicResource BtnBorder}"
                        Foreground="{DynamicResource BtnFg}"/>
                <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="10,0"
                        Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                        Thumb.DragStarted="OnSeekStarted" Thumb.DragCompleted="OnSeekCompleted"/>
                <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00 / 0:00" FontSize="11"
                           Foreground="{DynamicResource InkHint}" VerticalAlignment="Center" Margin="8,0"/>
                <Button x:Name="MuteButton" Grid.Column="3" Content="🔊" FontSize="12" Width="30" Height="26"
                        Cursor="Hand" Click="OnMute"
                        Background="{DynamicResource BtnBg}" BorderBrush="{DynamicResource BtnBorder}"
                        Foreground="{DynamicResource BtnFg}"/>
                <Slider x:Name="VolumeSlider" Grid.Column="4" Width="70" Minimum="0" Maximum="1"
                        Value="0.8" ValueChanged="OnVolumeChanged"/>
            </Grid>

            <!-- 下载 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DownloadHint" FontSize="11" Foreground="{DynamicResource InkHint}"
                           VerticalAlignment="Center"/>
                <Button x:Name="DownloadButton" Grid.Column="1" Content="⬇ 下载"
                        FontSize="12.5" FontWeight="SemiBold"
                        Padding="16,6" Height="32" Cursor="Hand"
                        Background="{DynamicResource Accent}" Foreground="White"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                        Click="OnDownload"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
