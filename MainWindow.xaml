<Window x:Class="JsonFormatter.MainWindow"
        xmlns:media="clr-namespace:JsonFormatter.Media.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JsonFormatter" Width="1220" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvas}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- 键盘焦点：accent 描边（所有按钮共用） -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle RadiusX="7" RadiusY="7" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮词汇表：默认态（全界面同一形状） -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作：全界面仅「格式化」使用 accent 实底 -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBright}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 隐藏空值开关：胶囊，按下态 accent 实底 -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource InkCaption}"/>
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 树展开箭头：悬停变 accent（状态反馈） -->
        <Style x:Key="ChevronToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="18" Height="18">
                            <Path x:Name="arrow"
                                  Data="M 0,0 L 4,4 L 0,8"
                                  Stroke="#93ACA0" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource AccentBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 树节点：行背景由 VM 的选中/子树标记驱动 -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="bd" Padding="3,1.5,8,1.5" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSubtreeHighlighted}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelSub}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelectedNode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelRow}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="expander" Style="{StaticResource ChevronToggle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press"/>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                      ContentSource="Header" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="itemsHost" Margin="17,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="itemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverRow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索命中高亮（三主题通用暖黄） -->
        <SolidColorBrush x:Key="SearchHitBrush" Color="#FFF7D66A"/>

        <!-- 树节点内容：key 近黑，值按类型着色 -->
        <HierarchicalDataTemplate DataType="{x:Type local:JsonNodeVM}"
                                  ItemsSource="{Binding Children}"
                                  xmlns:local="clr-namespace:JsonFormatter">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding KeyText}" Foreground="{Binding KeyBrush}"
                           FontWeight="{Binding KeyWeight}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchHitKey}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SearchHitBrush}"/>
                                    <Setter Property="Padding" Value="3,0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="&#160;:&#160;" Foreground="{DynamicResource InkHint}"
                           Visibility="{Binding SepVisibility}"/>
                <ContentControl Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SlotText}" Foreground="{Binding SlotBrush}"
                                                   FontWeight="{Binding SlotWeight}" FontStyle="{Binding SlotStyle}"
                                                   ToolTip="{Binding SlotTooltip}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchHitValue}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SearchHitBrush}"/>
                                                            <Setter Property="Padding" Value="3,0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMediaUrl}" Value="True">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <media:MediaValueControl/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- 分隔条：悬停提示可拖拽 -->
        <Style x:Key="SplitterStyle" TargetType="GridSplitter">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="bd" Background="Transparent" Width="10">
                            <Rectangle Width="1" Margin="0,14" Fill="{DynamicResource LineStrong}"
                                       HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="{DynamicResource BgChrome}"
                BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">

                <!-- 品牌 -->
                <TextBlock Text="{}{ }" FontFamily="Cascadia Mono, Consolas" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource BrandGlyph}"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="JsonFormatter" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource InkCaption}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                <Button Style="{StaticResource PrimaryButton}" Content="格式化" Click="OnFormatClick"/>
                <Button Style="{StaticResource ToolButton}" Content="压缩" Margin="8,0,0,0"
                        Click="OnMinifyClick"/>
                <Button Style="{StaticResource ToolButton}" Content="压缩原文" Margin="8,0,0,0"
                        Click="OnMinifyRawClick"/>
                <Button Style="{StaticResource ToolButton}" Content="复制" Margin="8,0,0,0"
                        Click="OnCopyClick"/>
                <Button Style="{StaticResource ToolButton}" Content="清空" Margin="8,0,0,0"
                        Click="OnClearClick"/>

                <Rectangle Width="1" Height="18" Fill="{DynamicResource LineStrong}" Margin="12,0"/>

                <Button Style="{StaticResource ToolButton}" Content="展开全部" Click="OnExpandAllClick"/>
                <Button Style="{StaticResource ToolButton}" Content="折叠全部" Margin="8,0,0,0"
                        Click="OnCollapseAllClick"/>

                <Rectangle Width="1" Height="18" Fill="{DynamicResource LineStrong}" Margin="12,0"/>

                <Button Style="{StaticResource ToolButton}" Content="示例" Click="OnSampleClick"/>

            </StackPanel>
        </Border>

        <!-- 主体两栏 -->
        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 左：源码输入 -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgHeader}"
                            BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1"
                            CornerRadius="9,9,0,0">
                        <Grid Margin="14,0">
                            <TextBlock Text="源码输入" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkCaption}" VerticalAlignment="Center"/>
                            <TextBlock Text="粘贴后自动解析" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource InkHint}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <TextBox x:Name="InputBox"
                                 FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                 FontSize="13" Foreground="{DynamicResource InkBody}"
                                 CaretBrush="{DynamicResource AccentBright}" SelectionBrush="#B5E6D2"
                                 Background="White" BorderThickness="0"
                                 Padding="12,10" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextChanged="OnInputTextChanged"
                                 PreviewMouseLeftButtonDown="OnInputLeftButtonDown"/>
                        <TextBlock x:Name="Placeholder" Text="在此粘贴或输入 JSON 源码…"
                                   Foreground="{DynamicResource InkHint}" FontSize="13" Margin="14,12,0,0"
                                   IsHitTestVisible="False" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Style="{StaticResource SplitterStyle}"/>

            <!-- 右：格式化结果 -->
            <Border Grid.Column="2" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgHeader}"
                            BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1"
                            CornerRadius="9,9,0,0">
                        <Grid Margin="14,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="格式化结果" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkCaption}" VerticalAlignment="Center"/>
                            <!-- 搜索：一个输入框 + 键/值两个搜索按钮 -->
                            <TextBox Grid.Column="1" x:Name="SearchBox" Width="148" Height="24" Margin="16,0,0,0"
                                     VerticalContentAlignment="Center" FontSize="12"
                                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                     Foreground="{DynamicResource InkBody}" CaretBrush="{DynamicResource AccentBright}"
                                     Background="White" BorderBrush="{DynamicResource LineStrong}"
                                     BorderThickness="1" Padding="7,0"
                                     AutomationProperties.Name="搜索框"
                                     KeyDown="OnSearchBoxKeyDown" TextChanged="OnSearchBoxTextChanged"/>
                            <Button Grid.Column="2" x:Name="SearchKeyBtn" Style="{StaticResource ToolButton}"
                                    Content="键搜索" Height="24" FontSize="11.5" Padding="9,0" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Click="OnSearchKey"
                                    AutomationProperties.Name="键搜索"/>
                            <Button Grid.Column="3" x:Name="SearchValueBtn" Style="{StaticResource ToolButton}"
                                    Content="值搜索" Height="24" FontSize="11.5" Padding="9,0" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Click="OnSearchValue"
                                    AutomationProperties.Name="值搜索"/>
                            <ToggleButton Grid.Column="4" x:Name="HideEmptyToggle" Style="{StaticResource ChipToggle}"
                                          Content="隐藏null值和空数组" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Click="OnHideEmptyToggle"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- 静态关闭虚拟化：默认折叠策略已限制展开节点数；
                             开启虚拟化时大文件宽层数组的容器不生成，定位/搜索滚动会失效 -->
                        <TreeView x:Name="ResultTree" Background="White" BorderThickness="0"
                                  FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                  Padding="8,6"
                                  VirtualizingPanel.IsVirtualizing="False"
                                  ScrollViewer.CanContentScroll="False"
                                  SelectedItemChanged="OnSelectedItemChanged"
                                  ContextMenuOpening="OnTreeContextMenuOpening">
                        </TreeView>

                        <!-- 空状态：教第一步 -->
                        <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="{}{ }" FontFamily="Cascadia Mono, Consolas" FontSize="46"
                                       Foreground="{DynamicResource EmptyMark}" HorizontalAlignment="Center"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="粘贴 JSON，右侧即时解析" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkCaption}" HorizontalAlignment="Center"/>
                            <TextBlock Text="数组折叠标数 · 修改标红 · 单击源码定位" FontSize="11.5"
                                       Foreground="{DynamicResource InkHint}" HorizontalAlignment="Center"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 轻提示 Toast：0.5s 自动消失 -->
        <Border x:Name="Toast" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,66,0,0"
                Background="#E61F2A24" CornerRadius="18" Padding="18,9"
                Panel.ZIndex="100">
            <TextBlock x:Name="ToastText" Text="&#x2714; 复制成功" Foreground="White" FontSize="12.5"/>
        </Border>

        <!-- 多媒体固定卡片（全局唯一） -->
        <ContentControl x:Name="MediaCardHost" Grid.Row="1" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Panel.ZIndex="90" Focusable="False"/>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource BgChrome}"
                BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,1,0,0">
            <Grid Height="34" Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource InkHint}"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource InkStatus}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SizeText" Foreground="{DynamicResource InkStatus}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="GearButton" Style="{StaticResource ToolButton}" Click="OnGearClick"
                            Width="36" Height="26" Padding="0" ToolTip="设置"
                            AutomationProperties.Name="设置">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource InkCaption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
