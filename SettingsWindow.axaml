<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JsonFormatter.SettingsWindow"
        Title="设置" Width="420" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgCanvas}"
        FontSize="13">

    <StackPanel Margin="22,18" Spacing="18">

        <!-- 主题 -->
        <StackPanel Spacing="10">
            <TextBlock Text="界面主题" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkCaption}"/>
            <UniformGrid Columns="3">
                <Border x:Name="CardGreen" Classes="themecard" Cursor="Hand"
                        Tag="Green" PointerPressed="OnThemeCardPressed">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Ellipse Width="16" Height="16" Fill="#10B981"/>
                            <Ellipse Width="16" Height="16" Fill="#EFF5F1" Stroke="#DFE9E3" StrokeThickness="1"/>
                            <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#DFE9E3" StrokeThickness="1"/>
                        </StackPanel>
                        <TextBlock Text="清新绿" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource InkCaption}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardPaper" Classes="themecard" Cursor="Hand" Margin="10,0"
                        Tag="Paper" PointerPressed="OnThemeCardPressed">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Ellipse Width="16" Height="16" Fill="#B98A1C"/>
                            <Ellipse Width="16" Height="16" Fill="#F5EFDF" Stroke="#E4D8BE" StrokeThickness="1"/>
                            <Ellipse Width="16" Height="16" Fill="#FFFDF6" Stroke="#E4D8BE" StrokeThickness="1"/>
                        </StackPanel>
                        <TextBlock Text="纸质黄" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource InkCaption}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardWhite" Classes="themecard" Cursor="Hand"
                        Tag="White" PointerPressed="OnThemeCardPressed">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Ellipse Width="16" Height="16" Fill="#2456C4"/>
                            <Ellipse Width="16" Height="16" Fill="#F6F8FA" Stroke="#E2E6EB" StrokeThickness="1"/>
                            <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#E2E6EB" StrokeThickness="1"/>
                        </StackPanel>
                        <TextBlock Text="干净白" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource InkCaption}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <Rectangle Height="1" Fill="{DynamicResource LineSoft}"/>

        <!-- 字号 -->
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="字体大小" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource InkCaption}" VerticalAlignment="Center"/>
                <TextBlock x:Name="FontSizeLabel" Grid.Column="1" FontSize="12.5" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Slider x:Name="FontSizeSlider" Minimum="11" Maximum="20"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Aa" FontSize="11" Width="28" TextAlignment="Center"
                           Foreground="{DynamicResource InkHint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </StackPanel>

        <Rectangle Height="1" Fill="{DynamicResource LineSoft}"/>

        <!-- 全屏 -->
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="默认全屏启动" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource InkCaption}"/>
                <TextBlock Text="下次启动窗口时最大化" FontSize="11"
                           Foreground="{DynamicResource InkHint}"/>
            </StackPanel>
            <ToggleSwitch x:Name="FullscreenSwitch" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>

    </StackPanel>

    <Window.Styles>
        <Style Selector="Border.themecard">
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,12"/>
        </Style>
        <Style Selector="Border.themecard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
        </Style>
        <Style Selector="Border.themecard.sel">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
    </Window.Styles>
</Window>
